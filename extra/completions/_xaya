#compdef xaya

autoload -U is-at-least

_xaya() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--embed=[X11 window ID to embed Alacritty within (decimal or hexadecimal with "0x" prefix)]:EMBED:_default' \
'--socket=[Path for IPC socket creation]:SOCKET:_files' \
'--working-directory=[Start the shell in the specified working directory]:WORKING_DIRECTORY:_files' \
'*-e+[Command and args to execute (must be last argument)]:COMMAND:_default' \
'*--command=[Command and args to execute (must be last argument)]:COMMAND:_default' \
'-T+[Defines the window title \[default\: XaYa\]]:TITLE:_default' \
'--title=[Defines the window title \[default\: XaYa\]]:TITLE:_default' \
'--class=[Defines window class/app_id on X11/Wayland \[default\: xaya\]]:general> | <general>,<instance:_default' \
'*-o+[Override configuration file options \[example\: '\''cursor.style="Beam"'\''\]]:OPTION:_default' \
'*--option=[Override configuration file options \[example\: '\''cursor.style="Beam"'\''\]]:OPTION:_default' \
'--config-file=[Specify alternative configuration file \[default\: \$HOME/.config/xaya/xaya.toml\].]:CONFIG_FILE:_files' \
'--print-events[Print all events to STDOUT]' \
'(--daemon)--ref-test[Generates ref test]' \
'(-v)*-q[Reduces the level of verbosity (the min level is -qq)]' \
'(-q)*-v[Increases the level of verbosity (the max level is -vvv)]' \
'--daemon[Do not spawn an initial window]' \
'--hold[Remain open after child process exit]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_xaya_commands" \
"*::: :->xaya" \
&& ret=0
    case $state in
    (xaya)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:xaya-command-$line[1]:"
        case $line[1] in
            (msg)
_arguments "${_arguments_options[@]}" : \
'-s+[IPC socket connection path override]:SOCKET:_files' \
'--socket=[IPC socket connection path override]:SOCKET:_files' \
'-h[Print help]' \
'--help[Print help]' \
":: :_xaya__msg_commands" \
"*::: :->msg" \
&& ret=0

    case $state in
    (msg)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:xaya-msg-command-$line[1]:"
        case $line[1] in
            (create-window)
_arguments "${_arguments_options[@]}" : \
'--working-directory=[Start the shell in the specified working directory]:WORKING_DIRECTORY:_files' \
'*-e+[Command and args to execute (must be last argument)]:COMMAND:_default' \
'*--command=[Command and args to execute (must be last argument)]:COMMAND:_default' \
'-T+[Defines the window title \[default\: XaYa\]]:TITLE:_default' \
'--title=[Defines the window title \[default\: XaYa\]]:TITLE:_default' \
'--class=[Defines window class/app_id on X11/Wayland \[default\: xaya\]]:general> | <general>,<instance:_default' \
'*-o+[Override configuration file options \[example\: '\''cursor.style="Beam"'\''\]]:OPTION:_default' \
'*--option=[Override configuration file options \[example\: '\''cursor.style="Beam"'\''\]]:OPTION:_default' \
'--hold[Remain open after child process exit]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(config)
_arguments "${_arguments_options[@]}" : \
'-w+[Window ID for the new config]:WINDOW_ID:_default' \
'--window-id=[Window ID for the new config]:WINDOW_ID:_default' \
'()-r[Clear all runtime configuration changes]' \
'()--reset[Clear all runtime configuration changes]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'*::options -- Configuration file options \[example\: '\''cursor.style="Beam"'\''\]:_default' \
&& ret=0
;;
(get-config)
_arguments "${_arguments_options[@]}" : \
'-w+[Window ID for the config request]:WINDOW_ID:_default' \
'--window-id=[Window ID for the config request]:WINDOW_ID:_default' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--json[Print JSON instead of a table]' \
'(--watch)--wait[Wait until no window has a program working, then print]' \
'--watch[Keep running and print each window as its program reports something new, one line per change; with \`--json\`, one JSON object per line]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(focus)
_arguments "${_arguments_options[@]}" : \
'-w+[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'--window-id=[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(get-text)
_arguments "${_arguments_options[@]}" : \
'-w+[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'--window-id=[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'(--last-command)--lines=[The last rows with content, scrollback included, rather than the screen]:LINES:_default' \
'--last-command[The last shell command and its output, from shell integration]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(send-text)
_arguments "${_arguments_options[@]}" : \
'-w+[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'--window-id=[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'--enter[Press Enter after the text, submitting it]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':text -- Text to send:_default' \
&& ret=0
;;
(create-worktree)
_arguments "${_arguments_options[@]}" : \
'-w+[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'--window-id=[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'-b+[Branch to create, or check out if it exists; by default the first free \`agent-N\`]:BRANCH:_default' \
'--branch=[Branch to create, or check out if it exists; by default the first free \`agent-N\`]:BRANCH:_default' \
'-c+[Command to start in the new tab; by default \`worktree.command\`, or the window'\''s agent]:COMMAND:_default' \
'--command=[Command to start in the new tab; by default \`worktree.command\`, or the window'\''s agent]:COMMAND:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(split)
_arguments "${_arguments_options[@]}" : \
'-w+[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'--window-id=[Window ID, as \`msg status\` lists it; the focused window when absent]:WINDOW_ID:_default' \
'-c+[Command typed into the new pane'\''s shell once it'\''s ready]:COMMAND:_default' \
'--command=[Command typed into the new pane'\''s shell once it'\''s ready]:COMMAND:_default' \
'-d[Put the new pane below the focused one, rather than on its right]' \
'--down[Put the new pane below the focused one, rather than on its right]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_xaya__msg__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:xaya-msg-help-command-$line[1]:"
        case $line[1] in
            (create-window)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(config)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(get-config)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(focus)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(get-text)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(send-text)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(create-worktree)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(split)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(agent)
_arguments "${_arguments_options[@]}" : \
'*::arguments:_default' \
&& ret=0
;;
(run)
_arguments "${_arguments_options[@]}" : \
