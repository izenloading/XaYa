(( $+functions[_xaya_commands] )) ||
_xaya_commands() {
    local commands; commands=(
'msg:Send a message to the Alacritty socket' \
'agent:Manage the local agent service (start, status, stop)' \
'run:Start a managed Codex or Claude session in the current terminal' \
'attach:Attach the native engine TUI to a managed session' \
'checkpoint:Capture a managed workspace in a private Git reference' \
'check:Run and inspect checkpoint verification commands' \
'project:Inspect and trust repository verification commands' \
'land:Preview, verify and land a squash candidate on a local branch' \
'review:Review a checkpoint with a headless engine in a private, read-only checkout' \
'task:Tasks\: a goal and testable acceptance criteria for sessions, used by reviews' \
'migrate:Migrate the configuration file' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'xaya commands' commands "$@"
}
